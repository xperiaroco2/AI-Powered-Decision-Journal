{
  "title": "API – Golden Signals",
  "uid": "api-golden-signals",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "route",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(http_requests_total, route)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "label": "Route"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "RPS per route (requests / second)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (route, method) (rate(http_requests_total{route=~\"$route\"}[1m]))",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p50 / p95 / p99 Latency per route (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, route) (rate(http_request_duration_seconds_bucket{route=~\"$route\"}[1m])))",
          "legendFormat": "p50 {{route}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{route=~\"$route\"}[1m])))",
          "legendFormat": "p95 {{route}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(http_request_duration_seconds_bucket{route=~\"$route\"}[1m])))",
          "legendFormat": "p99 {{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx Error rate (errors / second)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (route) (rate(http_errors_total{route=~\"$route\"}[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "5xx Error % of total",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "100 * sum(rate(http_errors_total[1m])) / sum(rate(http_requests_total[1m]))",
          "legendFormat": "error %"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Event Loop Lag (seconds)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "process_event_loop_lag_seconds",
          "legendFormat": "event loop lag"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Heap Memory (bytes)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "process_heap_used_bytes",
          "legendFormat": "heap used"
        },
        {
          "expr": "process_heap_total_bytes",
          "legendFormat": "heap total"
        },
        {
          "expr": "process_rss_bytes",
          "legendFormat": "RSS"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Active Handles (sockets, timers, …)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "expr": "process_active_handles",
          "legendFormat": "active handles"
        }
      ]
    }
  ]
}

