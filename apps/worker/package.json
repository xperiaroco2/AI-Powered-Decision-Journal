{
  "name": "worker",
  "version": "1.0.0",
  "description": "Background worker for decision analysis",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate --schema=../../prisma/schema.prisma && tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "jest --config ./test/jest-integration.json",
    "test:integration:watch": "jest --config ./test/jest-integration.json --watch",
    "test:integration:cov": "jest --config ./test/jest-integration.json --coverage",
    "test:all": "pnpm test && pnpm test:integration",
    "test:all:cov": "pnpm test:cov && pnpm test:integration:cov",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\""
  },
  "dependencies": {
    "@langchain/core": "^1.1.24",
    "@langchain/groq": "^1.1.0",
    "@langchain/langgraph": "^1.1.4",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.70.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.212.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.212.0",
    "@opentelemetry/resources": "^2.5.1",
    "@opentelemetry/sdk-metrics": "^2.5.1",
    "@opentelemetry/sdk-node": "^0.212.0",
    "@prisma/client": "^6.0.0",
    "@prisma/instrumentation": "^7.4.1",
    "bullmq": "^5.36.3",
    "dotenv": "^17.2.3",
    "groq-sdk": "^0.37.0",
    "ioredis": "^5.4.2",
    "mammoth": "^1.11.0",
    "pdf-parse": "^1.1.4",
    "pino": "^9.0.0",
    "prom-client": "^15.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.12.0",
    "@testcontainers/redis": "^11.12.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.19.31",
    "@types/pdf-parse": "^1.1.5",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.5.0",
    "prettier": "^3.8.1",
    "prisma": "^6.0.0",
    "testcontainers": "^11.12.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/index.ts",
      "!**/types.ts",
      "!**/*.d.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "html",
      "text",
      "text-summary",
      "lcov",
      "json"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 75,
        "lines": 80,
        "statements": 80
      }
    },
    "testEnvironment": "node"
  }
}
