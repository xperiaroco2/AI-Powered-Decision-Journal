generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// User Model
// ============================================================================
// Represents an authenticated user who can create decisions.
// Auth-library agnostic: supports both credentials (email + password) and OAuth.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?  // Optional: null for OAuth-only users
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  decisions   Decision[]
  attachments Attachment[]

  @@index([email])
}

// ============================================================================
// Decision Model
// ============================================================================
// Represents a user's documented decision with context and reasoning.
// Lifecycle: PENDING → PROCESSING → DONE | FAILED
model Decision {
  id                String         @id @default(cuid())
  userId            String
  situation         String         @db.Text // Long-form description
  chosenDecision    String         @db.Text // The actual decision made
  personalReasoning String?        @db.Text // Optional user's own reasoning
  status            DecisionStatus @default(PENDING)
  latestRunId       String?        // FK to latest analysis run
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Relations
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs        DecisionAnalysisRun[]   // Multiple analysis attempts
  latestRun   DecisionAnalysisRun?    @relation("LatestRun", fields: [latestRunId], references: [id])
  embedding   DecisionEmbedding?      // RAG: Vector embedding for advisory retrieval
  attachments Attachment[]            // RAG: User-provided documents related to this decision

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([latestRunId])
}

// ============================================================================
// DecisionAnalysisRun Model
// ============================================================================
// Represents a single analysis attempt for a decision.
// Supports multiple runs per decision (re-analyze/retry functionality).
model DecisionAnalysisRun {
  id         String           @id @default(cuid())
  decisionId String
  status     AnalysisRunStatus @default(PENDING)
  provider   String           // "mock" | "groq"

  // Result data (populated when status = COMPLETED)
  resultJson Json?            // Full analysis result: { category, cognitiveBiases, missedAlternatives, insights }

  // Denormalized fields for efficient aggregation (populated when status = COMPLETED)
  categoryText String?        // Denormalized category for dashboard queries
  biasesText   String[]       // Denormalized bias names for dashboard queries

  // Error data (populated when status = FAILED)
  error      String?          @db.Text

  // Timestamps
  createdAt  DateTime         @default(now())
  startedAt  DateTime?        // When status changed to PROCESSING
  finishedAt DateTime?        // When status changed to COMPLETED or FAILED

  // Relations
  decision         Decision   @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  latestForDecision Decision[] @relation("LatestRun")

  @@index([decisionId])
  @@index([status])
  @@index([createdAt])
  @@index([categoryText])
}

// ============================================================================
// Enums
// ============================================================================

enum DecisionStatus {
  PENDING    // Decision created, awaiting analysis
  PROCESSING // Analysis job is running
  DONE       // Analysis completed successfully
  FAILED     // Analysis failed (can be retried)
}

enum AnalysisRunStatus {
  PENDING    // Run created, awaiting processing
  PROCESSING // Run is being processed
  COMPLETED  // Run completed successfully
  FAILED     // Run failed
}

enum Category {
  CAREER              // Job changes, promotions, career pivots
  FINANCIAL           // Investments, purchases, budgeting
  RELATIONSHIPS       // Personal relationships, family decisions
  HEALTH              // Medical, fitness, lifestyle choices
  EDUCATION           // Learning, courses, degrees
  BUSINESS            // Entrepreneurship, strategy, partnerships
  LIFESTYLE           // Moving, hobbies, major life changes
  ETHICAL             // Moral dilemmas, values-based decisions
  CREATIVE            // Artistic, design, creative project choices
  TECHNICAL           // Technology choices, architecture decisions
  OTHER               // Uncategorized or multi-category decisions
}

// ============================================================================
// RAG Advisory Feature - Attachments
// ============================================================================

// Represents a user-uploaded text document for RAG-based advisory.
// Lifecycle: PENDING → PROCESSING → READY | FAILED
model Attachment {
  id         String           @id @default(cuid())
  userId     String
  decisionId String           // FK to Decision - attachments are always linked to a decision
  title      String           // User-provided title (e.g., "Employment Contract")
  content    String           @db.Text // Full text content (stored directly in DB)
  status     AttachmentStatus @default(PENDING)
  error      String?          @db.Text // Error message if chunking/embedding fails
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // Relations
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  decision Decision          @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  chunks   AttachmentChunk[] // Chunked segments for embedding

  @@index([userId])
  @@index([decisionId])
  @@index([status])
  @@index([createdAt])
}

// Represents a fixed-size chunk of an attachment.
// Each chunk is embedded separately for retrieval.
model AttachmentChunk {
  id           String    @id @default(cuid())
  attachmentId String
  chunkIndex   Int       // Sequential index (0, 1, 2, ...)
  content      String    @db.Text // Chunk text (e.g., 500 tokens with 100 overlap)
  startOffset  Int       // Character offset in original content
  endOffset    Int       // Character offset in original content
  createdAt    DateTime  @default(now())

  // Relations
  attachment Attachment               @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  embedding  AttachmentChunkEmbedding?

  @@unique([attachmentId, chunkIndex])
  @@index([attachmentId])
}

// ============================================================================
// RAG Advisory Feature - Embeddings
// ============================================================================

// Vector embedding for a Decision (for personal experience retrieval).
// Embeds: situation + chosenDecision + personalReasoning
model DecisionEmbedding {
  id         String              @id @default(cuid())
  decisionId String              @unique
  embedding  Unsupported("vector(1536)") // pgvector type
  status     EmbeddingStatus     @default(PENDING)
  error      String?             @db.Text
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  // Relations
  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Vector embedding for an AttachmentChunk (for document retrieval).
model AttachmentChunkEmbedding {
  id        String              @id @default(cuid())
  chunkId   String              @unique
  embedding Unsupported("vector(1536)") // pgvector type
  status    EmbeddingStatus     @default(PENDING)
  error     String?             @db.Text
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  // Relations
  chunk AttachmentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ============================================================================
// RAG Enums
// ============================================================================

enum AttachmentStatus {
  PENDING    // Attachment uploaded, awaiting chunking
  PROCESSING // Chunking and embedding in progress
  READY      // All chunks embedded and ready for retrieval
  FAILED     // Chunking or embedding failed
}

enum EmbeddingStatus {
  PENDING   // Embedding job queued
  COMPLETED // Embedding generated successfully
  FAILED    // Embedding generation failed
}
