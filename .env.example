# ============================================================================
# DATABASE (Required for both web + worker)
# ============================================================================
# PostgreSQL connection string
# Local: postgresql://app:app@localhost:5432/app
# Production: Use managed PostgreSQL (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://app:app@localhost:5432/app"

# ============================================================================
# REDIS (Required for both web + worker)
# ============================================================================
# Redis connection string for BullMQ queues + Pub/Sub
# Local: redis://localhost:6379
# Production: Use managed Redis (Upstash, Redis Cloud, Railway, etc.)
# TLS example: rediss://default:password@host:port
REDIS_URL="redis://localhost:6379"

# ============================================================================
# NEXTAUTH (Required for web only)
# ============================================================================
# Secret for JWT signing - MUST be unique per environment
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# Public URL of the web app
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ============================================================================
# NESTJS API (Required for web only - proxy layer)
# ============================================================================
# URL of the NestJS API backend
# Local: http://localhost:4000
# Production: https://your-api.example.com
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ============================================================================
# AI PROVIDER (Required for worker only)
# ============================================================================
# Options: mock | groq
# mock = always works, no API key needed (default for development)
# groq = production-grade orchestration with multi-step workflow, retry logic, and telemetry
AI_PROVIDER=mock

# Groq API Key (only needed if AI_PROVIDER=groq)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# ============================================================================
# EMBEDDING PROVIDER (Required for worker only - RAG feature)
# ============================================================================
# Options: mock | openai
# mock = deterministic fake embeddings, no API key needed (default for development)
# openai = OpenAI text-embedding-3-small (1536 dimensions)
EMBEDDING_PROVIDER=mock

# OpenAI API Key (only needed if EMBEDDING_PROVIDER=openai)
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# ============================================================================
# SERVER (Optional)
# ============================================================================
# Port for web server (default: 3000)
PORT=3000

# Hostname for web server (default: 0.0.0.0 for production)
# Use 0.0.0.0 to bind to all interfaces
HOSTNAME=0.0.0.0

# Node environment (development | production)
NODE_ENV=development
